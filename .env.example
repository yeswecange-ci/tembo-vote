# ============================================================
# Tembo Selfie & Vote - Configuration d'environnement
# Soiree Club Tembo du 14 aout 2026 (Bracongo)
# ============================================================

APP_NAME="Tembo Selfie & Vote"
# local en developpement, production le soir de l'evenement
APP_ENV=local
# Genere par `php artisan key:generate` - sert aussi au hachage des device_hash
APP_KEY=
# OBLIGATOIREMENT false en production (checklist securite Module 7)
APP_DEBUG=true
# URL publique complete, en https en production
APP_URL=http://localhost:8000

# Interface 100 % en francais
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
# Toutes les heures (rotation PIN, expiration) sont a l'heure de Kinshasa
APP_TIMEZONE=Africa/Kinshasa

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# info en production : debug est trop verbeux pour 5 h d'evenement
LOG_LEVEL=debug

# Base MySQL 8 / MariaDB 10.6+ dediee au dispositif
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tembo-vote
DB_USERNAME=root
DB_PASSWORD=

# Sessions Laravel (back-office) en base : aucun service externe a surveiller
SESSION_DRIVER=database
SESSION_LIFETIME=600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
# sync obligatoire : aucun queue worker a babysitter le soir J (contrainte projet)
QUEUE_CONNECTION=sync
# Redis ecarte : cache et rate limiting sur le driver database
CACHE_STORE=database

# Aucun mail n'est envoye par le dispositif
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@tembo.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ----- Dispositif Tembo -----
# Cle secrete de la route du mur LED (/ecran/{cle}) - generer avec : openssl rand -hex 20
TEMBO_SCREEN_KEY=
# Expiration de toutes les sessions invite (heure de Kinshasa).
# Le lendemain 06:00 : la soiree du 14 finit apres minuit, une expiration
# a minuit pile deconnecterait toute la salle en plein evenement.
TEMBO_SESSION_EXPIRES_AT="2026-08-22 06:00"
# Mot de passe des 2 comptes moderateurs seedes - fort et unique en production
TEMBO_MODERATOR_PASSWORD=
# Purge post-evenement : anciennete minimale en jours (photos avec
# consentement de reutilisation toujours conservees)
TEMBO_PURGE_AFTER_DAYS=30
# Sauvegardes : nombre de fichiers conserves (rotation)
TEMBO_BACKUP_KEEP=40
# Chemin de mysqldump si absent du PATH (WAMP : C:\wamp64\bin\mysql\...\bin\mysqldump.exe)
TEMBO_MYSQLDUMP_PATH=mysqldump

# En production uniquement : cookies servis exclusivement en HTTPS
# SESSION_SECURE_COOKIE=true
